# Gemini VLM is optional. Never commit a real key.
# CUBERELAY_VLM_API_KEY=
# CUBERELAY_VLM_MODEL=gemini-3.5-flash-lite
# CUBERELAY_VLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
# CUBERELAY_VLM_ENABLE_PASSWORD=replace-with-a-strong-random-password

# M4-B model A: image -> SemanticSceneObservation
# CUBERELAY_PERCEPTION_PROVIDER=openai_compatible
# CUBERELAY_PERCEPTION_ENDPOINT=http://multimodal-service.example/v1
# CUBERELAY_PERCEPTION_MODEL=vision-model
# CUBERELAY_ROUTER_MODEL=gemini-3.5-flash-lite
# CUBERELAY_PERCEPTION_API_KEY=
# CUBERELAY_PERCEPTION_TEMPERATURE=0
# CUBERELAY_PERCEPTION_TIMEOUT_SECONDS=45
# CUBERELAY_PERCEPTION_TOKEN_BUDGET=1200

# M4-B model B: semantics/CV/history -> AgentActionDecision (no image bytes)
# CUBERELAY_AGENT_PROVIDER=openai_compatible
# CUBERELAY_AGENT_ENDPOINT=http://planning-service.example/v1
# CUBERELAY_AGENT_MODEL=planning-model
# CUBERELAY_AGENT_API_KEY=
# CUBERELAY_AGENT_TEMPERATURE=0
# CUBERELAY_AGENT_TIMEOUT_SECONDS=45
# CUBERELAY_AGENT_TOKEN_BUDGET=1200

